void max(int *a, int *b);
int main() {
  int p1,p2;
  printf("enter 1st no :");
  scanf("%d",&p1);
  printf("enter 2nd no :");
  scanf("%d",&p2);
  max(&p1,&p2);

    return 0;
}
void max(int *a, int *b)
{
    int max;
    if(*a>*b)
    max=*a;
    else 
    max=*b;
    printf("max is %d",max);
}

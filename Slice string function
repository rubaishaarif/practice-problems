//slice function returns sliced string from m to n
#include<string.h>
#include <stdio.h>
void slice(char str[],int m,int n)
{
    for(int i=m;i<n;i++)
    {
        printf("%c\n",str[i]);
    }
}
int main() {
char arr[20];

int start,end;
printf("Enter string :");
scanf("%s",arr);
printf("Length of string is %d\n",strlen(arr));
printf("Enter starting index :");
scanf("%d",&start);
printf("Enter ending index :");
scanf("%d",&end);
slice(arr,start,end);
    return 0;
}
